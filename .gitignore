# --- Repo-specific (outside the dw-init managed block; survives re-runs) ---

# Node / pnpm (CI tooling: agnix, prettier)
node_modules/

# Scratch & personal notes (never published)
/tmp-*.md
/*.local.md
/research.md

# Rebuild working material — the brief and the cloned inspiration repos.
/TASK.md
/.inspirations/

# Codex's own hook wiring — machine-local copies of the guards, not the canon.
# Deliberately NOT tracked: they are a snapshot that predates bash-guard.sh, and
# nothing measures their drift. docs/agents/tooling.md carries what that costs.
/.codex/

# hookify rules — untracked by the plugin's own convention. The `/*.local.md`
# rule above is root-anchored and does not reach into .claude/.
/.claude/hookify.*.local.md

# >>> dw-init managed block >>>
# Personal agent memory & local overrides — never committed.
/CLAUDE.local.md
/.claude/settings.local.json

# Worktree scratch — `claude --worktree` / `git worktree add` land here.
/.claude/worktrees/

# Editor / OS scratch.
.DS_Store
*.swp
.vscode/
.idea/
.obsidian/

# NOTE: `.ai/`, `.claude/settings.json`, and `.claude/hooks/` are TRACKED on
# purpose — dw-* treats agent infra (change docs, backlog, guardrails) as
# committed work. Do NOT add them here.
# <<< dw-init managed block <<<

# Behaviour-eval output — traces and gradings, regenerated per run.
/evals/results/
