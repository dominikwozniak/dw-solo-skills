{
  "name": "dw-solo-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The thin lane — Claude Code skills for repos only you read, distributed as an installable plugin marketplace.",
  "scripts": {
    "lint": "scripts/lint.sh",
    "lint:fix": "agnix --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "validate:manifests": "scripts/validate-manifests.sh",
    "validate:artifacts": "scripts/validate-artifacts.sh",
    "validate:docs": "scripts/validate-docs.sh",
    "eval:routing": "node evals/routing.ts --min-rank1 67",
    "prepare": "husky"
  },
  "devDependencies": {
    "agnix": "^0.33.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "download"
    }
  }
}
