# Format every staged file with prettier (re-stages in place).
pnpm exec lint-staged

# Lint the agent-skills files with agnix, scoped to the staged paths only.
# `pnpm lint <paths>` would scope the same way, but this hook needs --fix and a
# re-stage, which the lint script deliberately does not do; agnix --fix mirrors
# the repo's `lint:fix`.
# templates/ is excluded in .agnix.toml, but an exclude only governs the project walk —
# a path handed over explicitly is linted anyway, and templates/AGENTS.md names `.ai/`
# and `.claude/` paths that exist only once dropped into a target repo. Filter it here.
agnix_files=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -v '^templates/' \
  | grep -E '((^|/)(SKILL|CLAUDE|AGENTS)\.md|\.claude-plugin/[^/]*\.json)$' || true)
if [ -n "$agnix_files" ]; then
  echo "$agnix_files" | xargs pnpm exec agnix --fix
  echo "$agnix_files" | xargs git add
fi

# When a plugin/marketplace manifest changed, enforce marketplace<->plugin
# version sync (the same check CI runs). A failure here blocks the commit.
if git diff --cached --name-only | grep -q '\.claude-plugin/'; then
  pnpm validate:manifests
fi
